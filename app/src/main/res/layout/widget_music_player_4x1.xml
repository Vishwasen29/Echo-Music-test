<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_click"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_background_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ytm_widget_panel" />

    <ImageView
        android:id="@+id/widget_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ytm_widget_gradient_overlay"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ytm_album_placeholder"
        android:contentDescription="Album art" />

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ytm_button_circle"
            android:padding="8dp"
            android:src="@drawable/ic_ytm_skip_previous"
            android:tint="#FFFFFFFF"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/ytm_button_circle_primary"
            android:padding="10dp"
            android:src="@drawable/ic_ytm_play_arrow"
            android:tint="#FFFFFFFF"
            android:contentDescription="Play pause" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ytm_button_circle"
            android:padding="8dp"
            android:src="@drawable/ic_ytm_skip_next"
            android:tint="#FFFFFFFF"
            android:contentDescription="Next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_song_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@id/widget_album_art"
        android:layout_toStartOf="@id/widget_controls"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="No song playing"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Echo Music"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/ytm_progress_horizontal" />
</RelativeLayout>
